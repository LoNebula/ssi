<?xml version="1.0"?>
<pipeline>
    <register>
        <load name="ssipython310"/>
        <load name="ssiopencv"/>
        <load name="ssiio"/>
        <load name="ssigraphics"/>
    </register>

    <sensor create="Camera" option="camera" fps="30">
        <output channel="video" pin="video_in"/>
    </sensor>

    <sensor create="Python" script="receiver_gopro" syspath="." sr="1.0">
        <output channel="state" pin="gopro_state_in"/>
    </sensor>

    <consumer create="VideoPainter" title="Webcam">
        <input pin="video_in" frame="1"/>
    </consumer>
    <consumer create="SignalPainter" title="GoPro Connection Status" size="10">
        <input pin="gopro_state_in" frame="1"/>
    </consumer>

    <consumer create="FileWriter" path="gopro_status" type="csv">
        <input pin="gopro_state_in" frame="1"/>
    </consumer>
    <consumer create="VideoWriter" path="camera_video.avi">
        <input pin="video_in" frame="1"/>
    </consumer>
</pipeline>